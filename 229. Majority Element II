class Solution {
    public List<Integer> majorityElement(int[] nums) {
        List<Integer> ans = new ArrayList<>();

        int majority1 = Integer.MAX_VALUE;
        int count1 = 0;

        int majority2 = Integer.MAX_VALUE;
        int count2 = 0;

        for(int val : nums){
            if (majority1 == val) count1++;

            else if(majority2 == val) count2++;

            else if (count1 == 0) {
                majority1 = val;
                count1 = 1;
            } else if (count2 == 0) {
                majority2 = val;
                count2 = 1;
            }
            else {
                count2--;
                count1--;
            }
        }

        //verify
        int freq1 = 0;
        int freq2 = 0;
        for (int v : nums){
            if (v == majority1) freq1++;
            if (v == majority2) freq2++;
        }

        if (freq1 > (nums.length / 3)) ans.add(majority1);
        if (freq2 > (nums.length / 3)) ans.add(majority2);

        return ans;
    }
}
